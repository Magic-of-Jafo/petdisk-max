10 REM PETDISK MAX HARDWARE TEST
20 REM SEE TESTING.MD. RESULTS: PASS/FAIL/SKIP
30 PRINT "{clr}PETDISK MAX TEST"
40 PRINT "DEVICE NUMBERS FROM PETDISK.CFG"
50 INPUT "SD CARD DEVICE";SD
60 INPUT "NETWORK DEVICE, 0=NONE";NT
70 INPUT "2ND NETWORK DEVICE, 0=NONE";N2
80 PRINT "{down}FOR THE SUBFOLDER TEST, MAKE A FOLDER"
90 PRINT "PDTDIR IN THE NETWORK DRIVE'S FOLDER.{down}"
100 PF=0:FL=0:SK=0:PM=7:PA=3
110 T$="SD SEQ 1500":D=SD:F$="PDT1":N=1500:GOSUB 1000:GOSUB 9000
120 T$="SD SAVE+DIR":D=SD:GOSUB 2000:GOSUB 9000
130 IF NT=0 THEN 300
140 T$="NET SEQ 1500":D=NT:F$="PDT2":N=1500:GOSUB 1000:GOSUB 9000
150 T$="NET SAVE+DIR":D=NT:GOSUB 2000:GOSUB 9000
160 T$="NET MISSING FILE":D=NT:GOSUB 3000:GOSUB 9000
170 T$="NET<>SD COPY":GOSUB 4000:GOSUB 9000
180 T$="NET SUBFOLDER":D=NT:GOSUB 5000:GOSUB 9000
190 T$="NET SEQ 4000":D=NT:F$="PDT3":N=4000:GOSUB 1000:GOSUB 9000
200 IF N2=0 THEN 300
210 T$="TWO NET DRIVES":GOSUB 6000:GOSUB 9000
300 PRINT "{down}PASSED";PF;"FAILED";FL;"SKIPPED";SK
310 END
1000 REM WRITE F$ ON D, N BYTES, THEN VERIFY
1010 OPEN 2,D,2,"@:"+F$+",S,W"
1020 FOR I=1 TO N:PRINT#2,CHR$((I*PM+PA)AND255);:NEXT
1030 CLOSE 2
1100 REM VERIFY F$ ON D: N BYTES, PATTERN PM,PA
1110 R=0:C=0:B=0:OPEN 2,D,2,F$+",S,R"
1120 GET#2,A$:S=ST:C=C+1
1130 IF ASC(A$+CHR$(0))<>((C*PM+PA)AND255) THEN B=B+1
1140 IF S=0 AND C<N+10 THEN 1120
1150 CLOSE 2
1160 IF C=N AND B=0 AND S=64 THEN R=1:RETURN
1170 E$="READ"+STR$(C)+" BAD"+STR$(B)+" ST"+STR$(S):RETURN
2000 REM SAVE THIS PROGRAM TO D, FIND IT IN THE DIRECTORY
2010 SAVE "@:PDTSAVE",D
2020 N$="PDTSAVE":GOSUB 7000
2030 IF FD=1 THEN R=1:RETURN
2040 R=0:E$="NOT LISTED,"+STR$(NE)+" ENTRIES":RETURN
3000 REM READING A MISSING FILE MUST FAIL
3010 OPEN 2,D,2,"NOSUCHFILE,S,R":GET#2,A$:S=ST:CLOSE 2
3020 IF S<>0 THEN R=1:RETURN
3030 R=0:E$="ST=0, GOT DATA":RETURN
4000 REM COPY NET TO SD AND SD TO NET, BYTE BY BYTE
4010 D=NT:F$="PDT4":N=1500:GOSUB 1000:IF R=0 THEN E$="WRITE "+E$:RETURN
4020 OPEN 2,NT,2,"PDT4,S,R":OPEN 3,SD,3,"@:PDT4C,S,W"
4030 GET#2,A$:S=ST:PRINT#3,CHR$(ASC(A$+CHR$(0)));:IF S=0 THEN 4030
4040 CLOSE 3:CLOSE 2
4050 D=SD:F$="PDT4C":GOSUB 1100:IF R=0 THEN E$="TO SD "+E$:RETURN
4060 OPEN 2,SD,2,"PDT4C,S,R":OPEN 3,NT,3,"@:PDT4D,S,W"
4070 GET#2,A$:S=ST:PRINT#3,CHR$(ASC(A$+CHR$(0)));:IF S=0 THEN 4070
4080 CLOSE 3:CLOSE 2
4090 D=NT:F$="PDT4D":GOSUB 1100:IF R=0 THEN E$="TO NET "+E$
4100 RETURN
5000 REM SUBFOLDER PDTDIR ON NETWORK DRIVE D
5010 N$="PDTDIR":GOSUB 7000
5020 IF FD=0 THEN R=2:E$="NO PDTDIR FOLDER":RETURN
5030 OPEN 15,D,15,"CD:PDTDIR":CLOSE 15
5040 F$="INDIR":N=600:GOSUB 1000:IF R=0 THEN E$="IN FOLDER "+E$:GOTO 5090
5050 N$="INDIR":GOSUB 7000:IF FD=0 THEN R=0:E$="NOT LISTED IN FOLDER":GOTO 5090
5060 OPEN 15,D,15,"CD"+CHR$(95):CLOSE 15
5070 N$="INDIR":GOSUB 7000:IF FD=1 THEN R=0:E$="LISTED IN TOP FOLDER"
5080 RETURN
5090 OPEN 15,D,15,"CD"+CHR$(95):CLOSE 15:RETURN
6000 REM TWO NETWORK DRIVES, DIFFERENT DATA, READ INTERLEAVED
6010 D=NT:F$="PDT6A":N=800:PM=7:PA=3:GOSUB 1000
6020 IF R=0 THEN E$="DRIVE 1 "+E$:RETURN
6030 D=N2:F$="PDT6B":N=800:PM=11:PA=5:GOSUB 1000:PM=7:PA=3
6040 IF R=0 THEN E$="DRIVE 2 "+E$:RETURN
6050 OPEN 2,NT,2,"PDT6A,S,R":OPEN 3,N2,3,"PDT6B,S,R":C=0:B=0
6060 GET#2,A$:S1=ST:GET#3,B$:S2=ST:C=C+1
6070 IF ASC(A$+CHR$(0))<>((C*7+3)AND255) THEN B=B+1
6080 IF ASC(B$+CHR$(0))<>((C*11+5)AND255) THEN B=B+1
6090 IF S1=0 AND S2=0 AND C<810 THEN 6060
6100 CLOSE 3:CLOSE 2
6110 IF C=800 AND B=0 THEN R=1:RETURN
6120 R=0:E$="READ"+STR$(C)+" BAD"+STR$(B):RETURN
7000 REM IS "N$" IN THE DIRECTORY OF D? FD=1 IF SO, NE=ENTRIES
7010 FD=0:NE=0:W$=CHR$(34)+N$+CHR$(34):LW=LEN(W$)
7020 OPEN 1,D,0,"$":GET#1,A$,A$
7030 GET#1,A$,B$:IF ST<>0 OR (A$="" AND B$="") THEN 7090
7040 GET#1,A$,B$:L$=""
7050 GET#1,A$:IF A$<>"" THEN L$=L$+A$:IF ST=0 THEN 7050
7060 NE=NE+1
7070 FOR K=1 TO LEN(L$)-LW+1:IF MID$(L$,K,LW)=W$ THEN FD=1
7080 NEXT:IF ST=0 THEN 7030
7090 CLOSE 1:RETURN
9000 REM PRINT RESULT R: 1 PASS, 0 FAIL, 2 SKIP
9010 R$="FAIL":IF R=1 THEN R$="PASS":PF=PF+1
9020 IF R=0 THEN FL=FL+1
9030 IF R=2 THEN R$="SKIP":SK=SK+1
9040 PRINT LEFT$(T$+"                ",17);R$;" ";E$
9050 E$="":RETURN
